# Whitelist: only the public site is tracked. Everything else (PDFs with traveler details, notes, scripts) stays local.
*
!.gitignore
!index.html
!styles.css
!app.js
!weather.js
!data/
!data/bookings.js
!data/itinerary.js
!data/routes.js
!assets/
